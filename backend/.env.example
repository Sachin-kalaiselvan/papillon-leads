# Copy to /opt/papillon-leads/backend/.env and fill in.

# PostgreSQL on this VPS
DATABASE_URL=postgresql://papillon:CHOOSE-A-PASSWORD@localhost:5432/papillon

# Public HTTPS address of this server (nginx in front)
PUBLIC_BASE_URL=https://leadsapi.papilloninteriors.in
DASHBOARD_URL=https://leads.papilloninteriors.in
ALLOWED_ORIGINS=https://leads.papilloninteriors.in,https://papilloninteriors.in,https://www.papilloninteriors.in,https://papllions.vercel.app
ADMIN_TOKEN=generate-a-long-random-string
SIGNING_SECRET=another-long-random-string
FOLLOWUP_ENABLED=true

BRAND_NAME=Papillon Interiors
BRAND_AGENT_NAME=Meera
BRAND_STUDIO_ADDRESS=our Bengaluru studio

# WhatsApp assistant's language model — Groq free tier (console.groq.com → API Keys)
LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Crawler for the Prospects page (runs on its own; Google key optional — OpenStreetMap is used either way)
CRAWLER_ENABLED=true
GOOGLE_MAPS_KEY=

# WhatsApp Cloud API (Meta Business → WhatsApp → API setup)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pick-any-string
WA_APP_SECRET=
WA_TPL_INTRO=papillon_enquiry_intro
WA_TPL_REMINDER=papillon_enquiry_reminder
WA_TPL_FORWARD=papillon_new_lead
WA_TPL_LANG=en

# Meta Lead Ads (Facebook/Instagram forms)
META_VERIFY_TOKEN=pick-any-string
META_PAGE_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Google Ads lead form → Webhook integration → key
GOOGLE_LEAD_KEY=

# Email for forwarded leads and reports
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=leads@theingredientlist.co
SMTP_PASSWORD=
MAIL_FROM=Papillon Leads <leads@theingredientlist.co>
