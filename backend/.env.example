# Copy to /opt/papillon-leads/backend/.env and fill in.

# Supabase → Project settings → Database → Connection string → "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Public HTTPS address of this server (nginx in front)
PUBLIC_BASE_URL=https://leads.theingredientlist.co
DASHBOARD_URL=https://papillon-leads.vercel.app
ALLOWED_ORIGINS=https://papllions.vercel.app,https://papilloninteriors.in
ADMIN_TOKEN=generate-a-long-random-string
SIGNING_SECRET=another-long-random-string
DIALER_ENABLED=true

BRAND_NAME=Papillon Interiors
BRAND_AGENT_NAME=Meera
BRAND_STUDIO_ADDRESS=our Bengaluru studio

# Exotel — needs KYC and "Connect Voice AI" enabled on the account (ask Exotel support)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_CALLER_ID=080XXXXXXXX
EXOTEL_BASE_URL=https://api.in.exotel.com
EXOTEL_RECORD=true

# Speech + language model
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1-mini
STT_PROVIDER=deepgram        # deepgram | sarvam
TTS_PROVIDER=sarvam          # sarvam | cartesia
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_VOICE=priya
CARTESIA_API_KEY=
CARTESIA_VOICE=

# WhatsApp Cloud API (Meta Business → WhatsApp → API setup)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=pick-any-string
WA_APP_SECRET=
WA_TPL_INTRO=papillon_enquiry_intro
WA_TPL_MISSED_CALL=papillon_missed_call
WA_TPL_FORWARD=papillon_new_lead
WA_TPL_LANG=en

# Meta Lead Ads (Facebook/Instagram forms)
META_VERIFY_TOKEN=pick-any-string
META_PAGE_TOKEN=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Google Ads lead form → Webhook integration → key
GOOGLE_LEAD_KEY=

# Email for forwarded leads and reports
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=leads@theingredientlist.co
SMTP_PASSWORD=
MAIL_FROM=Papillon Leads <leads@theingredientlist.co>
