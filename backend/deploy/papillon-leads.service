[Unit]
Description=Papillon lead pipeline (intake, auto-calls, WhatsApp, reports)
After=network-online.target

[Service]
User=sachin
WorkingDirectory=/home/sachin/papillon-leads/backend
EnvironmentFile=/home/sachin/papillon-leads/backend/.env
ExecStart=/home/sachin/papillon-leads/backend/.venv/bin/uvicorn papillon.main:app --host 127.0.0.1 --port 8090 --proxy-headers --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
